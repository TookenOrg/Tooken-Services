        {
            // Starts the local database and node, and frees port 8080 for the debugged API.
            "label": "compose: postgres + evm",
            "type": "shell",
            "command": "docker compose stop api && docker compose up -d --wait postgres evm",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}
