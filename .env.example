# Copy to .env and fill in. The server does not load .env by itself:
# export the variables, or use the VS Code launch configuration.
#
# The values below run the API on the host against the database and the node
# of docker-compose.yml (`docker compose up -d postgres evm`):
#   set -a; . ./.env.example; set +a; go run .

# --- Server ---
# Gin reads it directly: debug | release | test
GIN_MODE=debug
# Comma-separated, no spaces
CORS_ALLOWED_ORIGINS=http://localhost:3000
# true enables logger.LogTrace output
LOG_TRACE=false

# --- Database ---
DATABASE_URL=postgres://tooken:tooken@localhost:5433/tooken?sslmode=disable

# --- Blockchain ---
# WebSocket RPC endpoint (local Anvil node of docker-compose.yml; Sepolia: wss://...)
WS_RPC_URL=ws://127.0.0.1:8555
# Signer key, hex without 0x. NEVER commit a real one.
# Value below is the public Hardhat/Anvil test account #0: local chains only.
PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Minimum priority fee in gwei, fractional allowed (default 1, max 1000)
ETH_MIN_TIP_GWEI=1
# How long to wait for a transaction to be mined, Go duration (default 5m)
ETH_TX_WAIT=5m

# --- Orders ---
# How long an unpaid order holds its shares, Go duration (default 15m)
ORDER_RESERVATION_TTL=15m

# --- Tests only (integration tags) ---
# Throwaway database: integration tests write to it
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/postgres?sslmode=disable
# HTTP RPC of the local Hardhat node (tools/hardhat)
# ETH_TEST_RPC=http://127.0.0.1:8545
